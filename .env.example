# MedDuel — environment variables
# Copy this file to .env.local for local development.
# NEVER commit .env or .env.local — they contain real keys.

# ── Supabase (frontend, exposed to browser) ─────────────────────────────
# These are safe to ship in the client because RLS protects the data.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY-HERE

# ── Supabase (server / scripts only — NEVER ship to client) ────────────
# Used for seed scripts and admin tooling. Bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY-HERE
SUPABASE_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── Auth providers (configured in Supabase dashboard, listed here for reference) ──
# - Email magic link (no extra config)
# - Apple Sign-In   (Service ID, Team ID, Key ID, private key)
# - Google Sign-In  (Web client ID + iOS/Android client IDs)

# ── Capacitor / mobile ──────────────────────────────────────────────────
# Bundle IDs used by iOS / Android builds.
CAPACITOR_APP_ID=com.medduel.app
CAPACITOR_APP_NAME=MedDuel

# ── Optional: analytics ─────────────────────────────────────────────────
# VITE_POSTHOG_KEY=
# VITE_POSTHOG_HOST=https://eu.posthog.com
